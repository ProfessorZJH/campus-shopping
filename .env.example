# 使用 python scripts/generate-env.py 生成随机的本地配置，不要把实际 .env 提交到仓库。
APP_PORT=8091
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
AI_SERVICE_KEY=
ADMIN_USERNAME=campus_admin
ADMIN_PASSWORD=
BOOTSTRAP_ADMIN=true
# 生产必须 true；scripts/dev-up.py 显式加载 compose.local.yml 供本地 HTTP 开发。
SESSION_COOKIE_SECURE=true
# 生产须配置 MySQL 可信 CA（JVM truststore 或 JDBC trustCertificateKeyStoreUrl），身份验证 TLS 不可关闭。
DB_URL=
AI_TRUSTED_HTTP_HOSTS=milvus,qdrant
# 三个字段须成组填写。讯飞 MaaS 可用 /v2；具体模型 ID 以服务管控/控制台授权为准。
# LLM_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2
# 回答模型的读取超时为5至60秒，默认60；其他超时保留30秒。
LLM_TIMEOUT_SECONDS=60
# LLM_MODEL=spark-x2.6
# 真实 LLM_API_KEY 仅填写本地 .env，不要提交到 Git 或发送给前端。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 启用 docker compose --profile vector up 时设为 http://qdrant:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=campus_knowledge_v1
# SDD-08: 仅允许 TLS 或内网隧道，公网明文 http 不得传入 root 密码。
# 推荐在 Milvus 创建仅对 campus_products_v1 有权限的应用用户。
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_PRODUCT_COLLECTION=campus_products_v1
AI_PRODUCT_VECTOR_SYNC_ENABLED=false
# NVIDIA NIM Embedding 参考（需确保模型在控制台可用）
# EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
# EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b

# SDD-12；正常启动使用独立安全/缓存实例，禁止在生产复用命名空间。
REDIS_ENABLED=true
REDIS_NAMESPACE=cs:dev
REDIS_SECURITY_ADDRESS=redis://127.0.0.1:6379
REDIS_CACHE_ADDRESS=redis://127.0.0.1:6380
REDIS_SECURITY_PASSWORD=
REDIS_CACHE_PASSWORD=
AI_MAX_CONCURRENT_REQUESTS=4
