{
  "name": "campus-shopping-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "format": "prettier --config .prettierrc.json --write \"src/**/*.{js,ts,vue}\" \"scripts/*.mjs\" \"../campus-shopping-*/src/{main,test}/java/**/*.java\"",
    "format:check": "prettier --config .prettierrc.json --check \"src/**/*.{js,ts,vue}\" \"scripts/*.mjs\" \"../campus-shopping-*/src/{main,test}/java/**/*.java\"",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/compiler-dom": "3.5.45",
    "acorn": "8.19.0",
    "magic-string": "0.30.17",
    "prettier": "3.9.10",
    "prettier-plugin-java": "2.11.0",
    "typescript": "7.0.2",
    "vite": "6.4.5",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "vue": "3.5.45"
  }
}
