<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath />
    </parent>
    <groupId>cn.bugstack.ai</groupId>
    <artifactId>campus-shopping</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <redisson.version>4.8.0</redisson.version>
        <!-- 七牛 Java SDK 固定版本：不做版本区间，升级需单独评审。 -->
        <qiniu.version>7.19.0</qiniu.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <frontend.skip>false</frontend.skip>
        <npm.executable>npm</npm.executable>
        <python.executable>python3</python.executable>
        <!-- 门禁插件版本集中声明：默认构建不激活，由 static-analysis profile 或模块显式启用。 -->
        <jacoco.version>0.8.12</jacoco.version>
        <enforcer.version>3.5.0</enforcer.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>
    <modules>
        <module>campus-shopping-types</module>
        <module>campus-shopping-api</module>
        <module>campus-shopping-domain</module>
        <module>campus-shopping-case</module>
        <module>campus-shopping-infrastructure</module>
        <module>campus-shopping-trigger</module>
        <module>campus-shopping-app</module>
    </modules>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>3.0.4</version>
            </dependency>
            <dependency>
                <groupId>cn.bugstack.ai</groupId>
                <artifactId>campus-shopping-types</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.bugstack.ai</groupId>
                <artifactId>campus-shopping-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.bugstack.ai</groupId>
                <artifactId>campus-shopping-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.bugstack.ai</groupId>
                <artifactId>campus-shopping-case</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.bugstack.ai</groupId>
                <artifactId>campus-shopping-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.bugstack.ai</groupId>
                <artifactId>campus-shopping-trigger</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <!-- 只在 pluginManagement 声明版本与配置，避免各模块重复声明；激活位置见 static-analysis profile。 -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>**/package-info.class</exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${enforcer.version}</version>
                    <configuration>
                        <rules>
                            <requireMavenVersion>
                                <version>[3.9.0,)</version>
                            </requireMavenVersion>
                            <requireJavaVersion>
                                <version>[17,)</version>
                            </requireJavaVersion>
                            <banDuplicatePomDependencyVersions />
                        </rules>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <failIfNoTests>false</failIfNoTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>windows-npm</id><activation><os><family>Windows</family></os></activation>
            <properties><npm.executable>npm.cmd</npm.executable><python.executable>python</python.executable></properties>
        </profile>
        <profile>
            <id>static-analysis</id>
            <!-- 覆盖率 profile 默认关闭，可按需通过 -Pstatic-analysis 启用。 -->
            <activation>
                <property>
                    <name>static.analysis</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jacoco-prepare-agent</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>jacoco-report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- maven-enforcer 只在 pluginManagement 声明：enforcer-api/enforcer-rules 未进离线仓库，联网确认后再在此追加 execution 启用。 -->
                </plugins>
            </build>
        </profile>
    </profiles>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
</project>
