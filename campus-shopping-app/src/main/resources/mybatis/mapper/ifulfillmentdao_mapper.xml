<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.bugstack.ai.infrastructure.dao.IFulfillmentDao">
    <select id="pickup" resultType="cn.bugstack.ai.infrastructure.dao.po.PickupPO">
SELECT * FROM ful_pickup_task WHERE order_id=#{order}<if test="lock"> FOR UPDATE</if>
    </select>
    <insert id="insert">
INSERT INTO ful_pickup_task(id,order_id,merchant_id,store_id,buyer_id,status) VALUES(#{p.id},#{p.orderId},#{p.merchantId},#{p.storeId},#{p.buyerId},#{p.status})
    </insert>
    <update id="save">
UPDATE ful_pickup_task SET status=#{p.status},credential_hash=#{p.credentialHash},expires_at=#{p.expiresAt} WHERE id=#{p.id}
    </update>
    <select id="list" resultType="cn.bugstack.ai.infrastructure.dao.po.PickupPO">
SELECT * FROM ful_pickup_task WHERE merchant_id=#{merchant} <if test="status != null and status != ''">AND status=#{status}</if> ORDER BY id DESC LIMIT #{limit} OFFSET #{offset}
    </select>
    <insert id="verify">
INSERT INTO ful_pickup_verification(id,pickup_id,operator_user_id) VALUES(#{id},#{pickup},#{actor})
    </insert>
    <select id="pickupsByOrders" resultType="cn.bugstack.ai.infrastructure.dao.po.PickupPO">
SELECT * FROM ful_pickup_task WHERE order_id IN <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
    </select>
</mapper>