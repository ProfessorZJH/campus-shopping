<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.bugstack.ai</groupId>
        <artifactId>campus-shopping</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>campus-shopping-app</artifactId>
    <dependencies>
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.bugstack.ai</groupId>
            <artifactId>campus-shopping-trigger</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.bugstack.ai</groupId>
            <artifactId>campus-shopping-infrastructure</artifactId>
        </dependency>
    </dependencies>
    <build>
        <finalName>campus-shopping-app</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>static/src/**</exclude><exclude>static/vendor/**</exclude><exclude>static/images/**</exclude>
                    <exclude>static/index.html</exclude><exclude>static/ui.bundle.js</exclude><exclude>static/ui-build.json</exclude>
                </excludes>
            </resource>
            <resource><directory>${project.build.directory}/generated-ui</directory><targetPath>static</targetPath></resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration><skip>${frontend.skip}</skip></configuration>
                <executions>
                    <execution>
                        <id>verify-schema-contract</id><phase>validate</phase><goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>false</skip><executable>${python.executable}</executable>
                            <arguments><argument>${maven.multiModuleProjectDirectory}/scripts/schema_contract.py</argument><argument>--check</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>record-build-source</id><phase>validate</phase><goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>false</skip><executable>${python.executable}</executable>
                            <arguments><argument>${maven.multiModuleProjectDirectory}/scripts/generate-release-manifest.py</argument><argument>--begin-build</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-locked-ui-dependencies</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${npm.executable}</executable>
                            <workingDirectory>${maven.multiModuleProjectDirectory}/frontend</workingDirectory>
                            <arguments><argument>ci</argument><argument>--no-audit</argument><argument>--no-fund</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build-ui-from-source</id><phase>generate-resources</phase><goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>node</executable>
                            <arguments>
                                <argument>${maven.multiModuleProjectDirectory}/frontend/scripts/build.mjs</argument>
                                <argument>--out=${project.build.directory}/generated-ui</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-delivery-manifest</id><phase>verify</phase><goals><goal>exec</goal></goals>
                        <configuration>
                            <skip>false</skip><executable>${python.executable}</executable>
                            <arguments><argument>${maven.multiModuleProjectDirectory}/scripts/generate-release-manifest.py</argument></arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>cn.bugstack.ai.Application</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
